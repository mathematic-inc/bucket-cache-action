{
  "name": "@mathematic-inc/bucket-cache-action",
  "version": "1.0.0",
  "private": true,
  "description": "S3 and GCS caching for GitHub Actions",
  "type": "module",
  "license": "MIT",
  "repository": "github:mathematic-inc/bucket-cache-action",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --exclude tests/integration.test.ts",
    "test:integration": "node scripts/setup-test-tools.mjs && vitest run tests/integration.test.ts"
  },
  "dependencies": {
    "@actions/cache": "5.0.5",
    "@actions/core": "3.0.1",
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/client-sts": "3.1131.0",
    "google-auth-library": "11.0.2",
    "zod": "4.6.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "yaml": "2.9.0"
  }
}
